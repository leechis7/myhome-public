{
  "name": "myhome",
  "version": "1.2.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev -p 40002 -H 127.0.0.1",
    "build": "next build",
    "lint": "eslint",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:psql": "cd ~/MyHome && docker compose exec postgres psql -U myhome -d myhome",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate:dev": "DRIZZLE_ENV=dev node scripts/migrate.mjs",
    "db:seed:dev": "DRIZZLE_ENV=dev tsx scripts/seed.ts",
    "db:psql:dev": "cd ~/MyHome && docker compose exec postgres psql -U myhome -d myhome_dev",
    "db:setup:dev": "./infra/setup-dev-db.sh",
    "release:patch": "npm version patch -m 'chore: release v%s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'chore: release v%s' && git push --follow-tags",
    "release:major": "npm version major -m 'chore: release v%s' && git push --follow-tags",
    "indexnow": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/indexnow.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@toast-ui/editor": "^3.2.2",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.2",
    "ical.js": "^2.2.1",
    "iron-session": "^9.0.1",
    "mermaid": "^12.0.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "dompurify": "$dompurify",
    "katex": "^0.18.9",
    "esbuild": "^0.25.0"
  }
}
