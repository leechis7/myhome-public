# 소스로 개발할 때 쓰는 값(npm run dev). 이 파일을 .env.local 로 복사해 채운다.
# Docker 로 띄우기만 할 때는 필요 없다 - README 의 「5분 안에 띄우기」 를 본다.

# PostgreSQL 접속 주소
DATABASE_URL=postgresql://myhome:<비밀번호>@127.0.0.1:5432/myhome

# 세션 쿠키 암호화 키 — 32자 이상. 생성: openssl rand -base64 32
SESSION_SECRET=

# 처음 관리자 비밀번호 (선택). 비워 두면 처음 /admin 을 열 때 정한다 — 앱 로그에
# 찍히는 설치 코드를 넣어야 한다
ADMIN_PASSWORD=

# 이 인스턴스의 주소. 없으면 http://localhost:3000 으로 본다
SITE_URL=http://localhost:40002

# 비밀글 · 일기장 · 메모와 화면에서 넣는 토큰 · 키를 암호화하는 열쇠 (선택).
# 32바이트 base64. 생성: openssl rand -base64 32
SECRETS_KEY=

# off 면 이 서버에서는 텔레그램으로 메모 · 할 일을 받지 않는다(같은 봇을 쓰는 개발기 등)
TELEGRAM_INBOX=

# ── 아래는 관리 › 설정 › 환경설정 에서도 넣을 수 있다(여기 값이 먼저) ──────────
# 알림 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 할 일 · 일정 미리 알림(on, 선택). 종일은 아침 8시, 시각은 1시간 · 30분 전
# TELEGRAM_REMINDERS=
# 책 찾기의 카카오 책 검색(developers.kakao.com 의 REST API 키). 비우면 카카오는 건너뜀
KAKAO_REST_API_KEY=
# Gemini 키(aistudio.google.com 무료): 책 소개 요약 · 텔레그램 AI 판정. 비우면 앞부분 줄이기 · 규칙
GEMINI_API_KEY=
# 오픈클로 게이트웨이(선택). 있으면 Gemini 보다 먼저. 도구를 끈 전용 에이전트를 권한다
OPENCLAW_URL=
OPENCLAW_TOKEN=
OPENCLAW_AGENT=
# 「+」 창의 AI 대화가 부를 에이전트(선택). 비우면 main
OPENCLAW_CHAT_AGENT=
# AI 엔진의 차례 · 사용(예: openclaw,-gemini). 비우면 오픈클로 → Gemini
AI_ENGINES=
# 홈페이지 API 토큰의 sha256(선택). 보통은 환경설정 › 홈페이지 API 에서 만든다
MYHOME_API_TOKEN_SHA256=
# 내 Calibre 서재(콘텐츠 서버)에서도 책을 찾는다
CALIBRE_URL=
CALIBRE_USER=
CALIBRE_PASSWORD=
# 기본 편집기(milkdown · tiptap · toast) ·
# 책 찾기 출처(kakao,-calibre,openlibrary) · 구글 캘린더(「이름 https://…」 을 ; 로)
DEFAULT_EDITOR=
BOOK_SOURCES=
GOOGLE_CALENDAR_ICAL=
# 책 소개 요약 프롬프트({제목} · {지은이} · {소개글}, 줄바꿈은 \n). 비우면 처음 값
BOOK_SUMMARY_PROMPT=
# 할 일 · 메모 판정 프롬프트({오늘} · {지금} · {종류} · {글}, 줄바꿈은 \n). 비우면 처음 값
TODO_AI_PROMPT=
# 글 요약 · 태그 제안 프롬프트 (선택, MYH-249). 줄바꿈은 \n. 비우면 처음 값
POST_AI_PROMPT=
# 나만 보는 글(메모 · 일기)을 AI 로 보내기 (선택, MYH-250). on 이면 그날 메모로 일기 초안. 비우면 끔
DIARY_AI=
# 일기 초안 프롬프트 (선택). 줄바꿈은 \n. 비우면 처음 값
DIARY_AI_PROMPT=
# 책 한 줄 평 · 분류 제안 프롬프트 (선택, MYH-251). 줄바꿈은 \n. 비우면 처음 값
BOOK_REVIEW_PROMPT=
BOOK_CATEGORY_PROMPT=
# 방명록 · 댓글 스팸 판정 프롬프트 (선택, MYH-252). 줄바꿈은 \n. 비우면 처음 값
SPAM_AI_PROMPT=
# 맞춤법 · 문장 다듬기 프롬프트 (선택, MYH-253). 줄바꿈은 \n. 비우면 처음 값
PROOF_AI_PROMPT=
UMAMI_WEBSITE_ID=
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# 글을 공개하면 IndexNow 로 빙 · 네이버에 알린다. 8~128자 영숫자(예: openssl rand -hex 16).
# 앱이 https://<주소>/<열쇠>.txt 를 내보낸다. 비우면 알리지 않는다
# INDEXNOW_KEY=
# MONITORING_DASHBOARD=

# 올린 파일을 두는 곳. 비우면 저장소 안 storage/uploads 를 쓴다
# UPLOAD_DIR=
