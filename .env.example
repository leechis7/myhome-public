# 소스로 개발할 때 쓰는 값(npm run dev). 이 파일을 .env.local 로 복사해 채운다.
# Docker 로 띄우기만 할 때는 필요 없다 - README 의 「5분 안에 띄우기」 를 본다.

# PostgreSQL 접속 주소
DATABASE_URL=postgresql://myhome:<비밀번호>@127.0.0.1:5432/myhome

# 세션 쿠키 암호화 키 — 32자 이상. 생성: openssl rand -base64 32
SESSION_SECRET=

# 처음 관리자 비밀번호 (선택). 비워 두면 처음 /admin 을 열 때 정한다 — 앱 로그에
# 찍히는 설치 코드를 넣어야 한다
ADMIN_PASSWORD=

# 이 인스턴스의 주소. 없으면 http://localhost:3000 으로 본다
SITE_URL=http://localhost:40002

# 비밀글 열쇠 (선택). 32바이트 base64. 생성: openssl rand -base64 32
SECRETS_KEY=

# 선택: 알림 · 통계 · Search Console · 감시
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# off 면 이 서버에서는 텔레그램으로 메모 · 할 일을 받지 않는다(같은 봇을 쓰는 개발기 등)
TELEGRAM_INBOX=
# 책 찾기를 카카오 책 검색으로(developers.kakao.com 의 REST API 키). 비우면 Open Library
KAKAO_REST_API_KEY=
UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# MONITORING_DASHBOARD=

# 올린 파일을 두는 곳. 비우면 저장소 안 storage/uploads 를 쓴다
# UPLOAD_DIR=
